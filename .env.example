# Base de données
DB_NAME=sonamines_candidatures
DB_USER=sonamines
DB_PASSWORD=sonamines123
DATABASE_URL=postgresql+asyncpg://sonamines:sonamines123@localhost:5432/sonamines_candidatures

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_BUCKET=documents-candidatures

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Contraintes fichiers (en Mo)
MAX_TAILLE_DOCUMENT_MO=10
MAX_TAILLE_PHOTO_MO=2

# Formats autorisés (listes séparées par des virgules)
FORMATS_DOCUMENTS_AUTORISES=pdf,doc,docx,jpg,jpeg,png
FORMATS_PHOTO_AUTORISES=jpg,jpeg,png

# Email (à configurer selon le fournisseur)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# SMS (à configurer selon le fournisseur)
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.com/send

# Logs
LOG_LEVEL=INFO